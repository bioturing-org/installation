# .env — Sonya deployment config. Rule: comments on their OWN lines only —
# never on the same line as a value (docker env_file passes it verbatim).

# root -> 8.0.11 | nonroot -> 8.0.10 (filled by prepare_sonya.sh)
IMAGE_MODE=

BIOTURING_IMAGE=

APPLICATION_DOMAIN=mytenant.bioturing.com

CONTAINER_NAME=mytenant.bioturing.com

JUPYTER_CONTAINER_NAME=jupyter-workspace-mytenant

COMPOSE_PROJECT_NAME=mytenant

# HAProxy in front: high port + 127.0.0.1. Direct: 80 + 0.0.0.0
APP_PORT=24000

# optional second host port (leave empty when unused)
# APP_PORT_EXTRA=443

# container port: 8080 = plain HTTP, 4433 = HTTPS (in-container cert)
# APP_CONTAINER_PORT=4433

BIND_ADDRESS=127.0.0.1

SSH_HOST_PORT=

SSH_BIND_ADDRESS=0.0.0.0

APP_CPUS=64

APP_MEMORY_LIMIT=250g

APP_MEMSWAP_LIMIT=500g

APP_SHM_SIZE=64gb

# nvidia = all GPUs (standard) | cdi hosts: set cdi
GPU_DRIVER=nvidia

STORAGE_DIR=/mnt/nas/<vol>/<tenant>/user_data

DATABASE_DIR=/mnt/nas/<vol>/<tenant>/database

GATEWAY_STORAGE_DIR=/mnt/nas/<vol>/sonya/<tenant>/gateway-storage

WORKSPACE_DATA_DIR=/mnt/nas/<vol>/sonya/<tenant>/workspace-data

WORKSPACE_HOMES_DIR=/mnt/nas/<vol>/sonya/<tenant>/workspace-homes

POSTGRES_DATA_DIR=/mnt/nas/<vol>/sonya/<tenant>/postgres

# host path with the certs — mounted at the SAME path in the container;
# the app auto-detects certs there
SSL_VOLUME=/config/ssl

# carried from legacy — never generate/change
JWT_SECRET=

# carried from legacy — never generate/change
BIOTURING_TOKEN=

# generate: openssl rand -base64 24 (auto-done by prepare_sonya.sh)
SONYA_DB_PASSWORD=

# generate: openssl rand -base64 24 (auto-done by prepare_sonya.sh)
SONYA_GATEWAY_SECURITY__SECRET_KEY=

# generate: openssl rand -base64 24 (auto-done by prepare_sonya.sh)
WORKSPACE_JWT_SECRET=

PERSONAL_MODE=false

DEBUG_MODE=false

MANUAL_REGISTER_KERNEL=true
