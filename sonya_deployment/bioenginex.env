# bioenginex.env — BioEngineX compute service config.
# if BIOENGINEX_SHARED_VOLUME differs from STORAGE_DIR in .env.

# container name — must match NO_PROXY in app-extra.env (do not rename
# unless you also update app-extra.env)
BIOENGINEX_CONTAINER_NAME=bioturing-bioenginex

# image version (BioTuring publishes this)
BIOENGINEX_VERSION=2.0.2

# ---- Volume mount paths (legacy parity — cross-checked vs .env) ----
# shared user data — MUST be the SAME host path as STORAGE_DIR in .env
# (mounted at /home/shared in BOTH the app and BioEngineX containers).
# validate_bioenginex.sh FAILS if this differs from STORAGE_DIR.
BIOENGINEX_SHARED_VOLUME=/root/script/docker/sonya_deployment/sonyatest/data/user_data

# BioEngineX private data (legacy installer default: <SHARED>/bioenginex,
# mounted at /home/enginex). A sibling dir outside the shared volume is
# also fine — must be readable/writable by uid 33 (www-data).
BIOENGINEX_DATA_VOLUME=/root/script/docker/sonya_deployment/sonyatest/data/user_data/bioenginex

# container-side mount targets — DO NOT change (the app hands BioEngineX
# absolute paths like /home/shared/<user>/file; renaming breaks them)
BIOENGINEX_SHARED_MOUNT=/home/shared

BIOENGINEX_DATA_MOUNT=/home/enginex

# published host ports -> container 35576 (HTTP) / 35577 (RPC)
BIOENGINEX_HTTP_PORT=35576

BIOENGINEX_RPC_PORT=35577

# legacy-parity env (was in /etc/docker/bioturing_ecosystem.env)
NVIDIA_DISABLE_REQUIRE=true
