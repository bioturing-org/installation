# app-extra.env — app-level env, passed RAW into the app container (env_file).
# Rule: comments on their OWN lines only — never on the same line as a value.
# VALIDATION_STRING: allowed login email-domains from the legacy container
# (comma-separated). Keep the line even if empty.

VALIDATION_STRING=

N_TQ_WORKERS=4

NO_PROXY=localhost,fc00::/7,.svc,kubernetes,127.0.0.1,10.0.0.0/8,10.42.0.90,.local,fe80::/10,192.168.10.0/24,.cluster.local,::1/128,.default,0.0.0.0,bioturing-bioenginex,bioturing-ecosystem
