# =============================================================================
# .env — GENERIC Sonya deployment template
# Copy this folder per tenant, fill in the values below.
#
# !! CRITICAL RULE (learned from the genentech 503 incident) !!
# NEVER put a comment on the same line as a value. The gateway receives this
# file RAW via env_file (docker does NOT strip '#' there) and compose passes
# env_file values verbatim — a trailing "# comment" becomes part of the value
# and breaks the app. Comments go on their OWN lines only (like this file).
#
# Mode 600, root:root after prepare_sonya.sh runs. NEVER commit filled files.
# =============================================================================

# ---- Image (filled by prepare_sonya.sh — root/nonroot question) ----
# nonroot -> bioturing/bioturing-ecosystem12:8.0.10 (app as www-data, storage-init)
# root    -> bioturing/bioturing-ecosystem12:8.0.11 (app as root, no storage-init)
IMAGE_MODE=root

BIOTURING_IMAGE=bioturing/bioturing-ecosystem12:8.0.11

# ---- Identity ----
# public FQDN — must match the BIOTURING_TOKEN allow_domain
APPLICATION_DOMAIN=sonyatest.bioturing.com

# main app container name (usually the FQDN)
CONTAINER_NAME=sonyatest.bioturing.com

# jupyter container — avoid clashes on multi-tenant hosts
JUPYTER_CONTAINER_NAME=jupyter-workspace-sonyatest

# compose project name: prefixes service containers + the network
COMPOSE_PROJECT_NAME=sonyatest

# ---- Ports ----
# Pattern A (HAProxy in front): high port + 127.0.0.1, e.g. 24000
# Pattern B (direct, no proxy): 80 + 0.0.0.0 (TLS terminates at the edge LB in
# front; the app speaks PLAIN HTTP on 8080 in-container — never map 443)
APP_PORT=8080

BIND_ADDRESS=0.0.0.0
# optional: publish ssh ONLY if the legacy container did (empty = not mapped)
SSH_HOST_PORT=

SSH_BIND_ADDRESS=0.0.0.0
# optional: explicit docker network subnet (only if the host ran out of
# default address pools, e.g. 10.100.x.0/24 on dgx2) — uncomment to use:
#NETWORK_SUBNET=10.100.20.0/24

# ---- Resources (legacy parity: from docker inspect of the legacy container) ----
APP_CPUS=32

APP_MEMORY_LIMIT=200g

APP_MEMSWAP_LIMIT=400g

APP_SHM_SIZE=32gb



# ---- GPU ----
# cdi    -> GPU_DEVICE_ID like nvidia.com/gpu=7
# nvidia -> GPU_DEVICE_ID like 0 / 1 / 2
GPU_DRIVER=nvidia

# ---- Dirs (host paths; created by prepare_sonya.sh if missing) ----
# -> mounted at /home/shared
STORAGE_DIR=/root/script/docker/sonya_deployment/sonyatest/data/user_data
# -> mounted at /database
DATABASE_DIR=/root/script/docker/sonya_deployment/sonyatest/data/database
# sonya stack data (one set per tenant)
GATEWAY_STORAGE_DIR=/root/script/docker/sonya_deployment/sonyatest/data/sonya/gateway-storage

WORKSPACE_DATA_DIR=/root/script/docker/sonya_deployment/sonyatest/data/sonya/workspace-data

WORKSPACE_HOMES_DIR=/root/script/docker/sonya_deployment/sonyatest/data/sonya/workspace-homes

POSTGRES_DATA_DIR=/root/script/docker/sonya_deployment/sonyatest/data/sonya/postgres

# host dir with the domain certs (created by prepare_sonya.sh; put certs in)
SSL_DIR=/root/script/docker/sonya_deployment/sonyatest/data/ssl
# in-container path the app reads certs from (legacy value)
SSL_VOLUME=/config/ssl

# ---- Secrets ----
# carried from legacy — never generate/change
JWT_SECRET=

# carried from legacy — never generate/change
BIOTURING_TOKEN=

# generate: openssl rand -base64 24 (auto-done by prepare_sonya.sh)
SONYA_DB_PASSWORD=

# generate: openssl rand -base64 24 (auto-done by prepare_sonya.sh)
SONYA_GATEWAY_SECURITY__SECRET_KEY=

# generate: openssl rand -base64 24 (auto-done by prepare_sonya.sh)
WORKSPACE_JWT_SECRET=

# ---- App behaviour (legacy parity) ----
PERSONAL_MODE=false

DEBUG_MODE=false

MANUAL_REGISTER_KERNEL=true
