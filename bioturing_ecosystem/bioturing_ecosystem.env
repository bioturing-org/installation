# ========================================
#           BioTuring Ecosystem
#         Deployment Environment File
# ========================================

# Name for the Docker container
CONTAINER_NAME=bioturing-ecosystem

# Domain name without http/https (e.g., lalit.bioturing.com)
BASE_URL=

# Token provided by BioTuring IT
BIOTURING_TOKEN=

# SSO domain allow list (e.g., @bioturing.com)
VALIDATION_STRING=


# === Network Proxy Settings ===

# Set only if behind a corporate proxy (else leave blank)
HTTP_PROXY=
HTTPS_PROXY=

# Domains to bypass proxy
NO_PROXY=localhost,fc00::/7,.svc,kubernetes,127.0.0.1,10.0.0.0/8,10.42.0.90,.local,fe80::/10,192.168.10.0/24,.cluster.local,::1/128,.default,0.0.0.0,bioturing-bioenginex,bioturing-ecosystem


# === Application Settings ===

# Number of task queue workers
N_TQ_WORKERS=4

# Docker image version tag (e.g., 3.0.1)
BBVERSION=3.0.1

# === Volume Mounts (absolute host paths) ===

# Volume for app-specific data
APP_DATA_VOLUME=/bioturing_ecosystem/app_data

# Volume for user data & shared files
USER_DATA_VOLUME=/bioturing_ecosystem/user_data

# Volume for database persistence
DATABASE_VOLUME=/bioturing_ecosystem/database

# Volume for SSL certificates (must contain tls.crt & tls.key)
SSL_VOLUME=/config/ssl


# === Exposing Ports ===

# Public HTTP port
HTTP_PORT=80

# Public HTTPS port
HTTPS_PORT=443

# ========================================
# IMPORTANT IF BIOENGINEX + ECOSYSTEM
# ========================================

# JWT_SECRET is required ONLY when installing BioEngineX.
# - BioEngineX selected during install -> this MUST be filled,
#   otherwise the installer exits with an error
# - BioEngineX NOT selected -> this is ignored and can stay empty
JWT_SECRET=

# ========================================
#              BIOENGINEX
# ========================================

# Shared Docker network for Ecosystem <-> BioEngineX communication.
# Both containers are attached to this network so they can reach each
# other by container name (Docker embedded DNS) instead of hard-coded IPs.
# NOTE: values below intentionally have NO quotes.
# docker run --env-file does NOT strip quotes (unlike bash 'source'),
# so quoted values would end up inside the container WITH the quote
# characters and break hostname resolution.
DOCKER_NETWORK=bioturing-net

BIOENGINEX_CONTAINER_NAME=bioturing-bioenginex
BIOENGINEX_VERSION=2.0.2
# Default: use the BioEngineX container DNS name on the shared Docker
# network (= BIOENGINEX_CONTAINER_NAME). No need to find/track any IP.
# ONLY override with a LAN IP (e.g. 192.168.1.50) if BioEngineX runs on a
# DIFFERENT physical server than the ecosystem.
BIOENGINEX_HOST=bioturing-bioenginex

# NOTE: these must match the ports the BioEngineX container listens on
# INTERNALLY (35576/35577). They are also published on the host, so if you
# change them here, traffic between the two containers uses these values.
BIOENGINEX_HTTP_PORT=35576
BIOENGINEX_RPC_PORT=35577
NVIDIA_DISABLE_REQUIRE=true

# ========================================
#              USAGE NOTES
# ========================================

# 1. No spaces around '=' sign
#    Correct: BASE_URL=lalit.bioturing.com
#    Wrong:   BASE_URL = lalit.bioturing.com

# 2. Use quotes ONLY if the value contains spaces
#    Example: SOME_VAR="value with space"

# 3. All volume paths must be absolute and exist on host

# 4. Required fields:
#    - BASE_URL
#    - BIOTURING_TOKEN
#    - VALIDATION_STRING

# 5. If using proxy, fill HTTP_PROXY and HTTPS_PROXY
#    If not, leave them blank